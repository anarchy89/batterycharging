#!/bin/bash
# batterycharging off  -> stop charging: freeze at current %, follow it down, never charge up
# batterycharging to N -> charge up to N%, then hold there exactly like 'off'
# batterycharging on   -> resume charging: stop holding and restore your previous charge limit
# batterycharging auto [LOW HIGH] -> opt in (set once): while holding, if the battery falls below
#                         LOW% (default 40), charge back up to HIGH% (default 60), then hold again
# batterycharging auto off -> turn that off again
# batterycharging --update  -> replace this script with the latest release, if that is newer
# batterycharging --version -> print the version
VERSION=1.0.1
RELEASE="https://github.com/anarchy89/batterycharging/releases/latest/download/batterycharging"
D=com.apple.smartcharging.topoffprotection
DIR="/Library/Application Support/batterycharging"
PID="$DIR/pid"; SAVED="$DIR/saved"; AUTO="$DIR/auto"

pct()     { pmset -g batt | grep -Eo '[0-9]+%' | head -1 | tr -d '%'; }
running() { [[ -f "$PID" ]] && ps -p "$(cat "$PID")" >/dev/null 2>&1; }
setlim()  {   # runs as root
  defaults write $D MCLFeatureState -int 1
  defaults write $D mclLimitValue -int "$1"
  notifyutil -p com.apple.smartcharging.defaultschanged
}
warn()    {   # a hold never charges back up unless 'auto' is set
  if [[ -f "$AUTO" ]] && read -r low high < "$AUTO"; then
    echo "Warning: auto refill is on: below $low% it charges back up to $high%, then holds again."
    echo "To hold without refilling, run 'batterycharging auto off'."
  else
    echo "Warning: left like this, the battery will eventually drain to 0%. Run 'batterycharging on'"
    echo "when it gets low, or set 'batterycharging auto' to recharge automatically."
  fi
}

case "$1" in
  --version) echo "batterycharging $VERSION" ;;
  --update)
    url=${BATTERYCHARGING_UPDATE_URL:-$RELEASE}    # the variable is an aid for testing
    self=$(realpath "$0" 2>/dev/null || echo "$0")
    new=$(mktemp -t batterycharging) || exit 1
    trap 'rm -f "$new"' EXIT
    echo "Checking $url"
    curl -fsSL -o "$new" "$url" || { echo "Could not download the latest release."; exit 1; }
    read -r name latest <<< "$(bash "$new" --version 2>/dev/null)"
    [[ "$name" == batterycharging && "$latest" =~ ^[0-9]+(\.[0-9]+)*$ ]] \
      || { echo "The downloaded file is not a working batterycharging."; exit 1; }
    if [[ "$latest" == "$VERSION" || "$(printf '%s\n' "$VERSION" "$latest" | sort -V | tail -1)" != "$latest" ]]; then
      echo "batterycharging $VERSION is up to date (the latest release is $latest)."; exit 0
    fi
    if [[ -w "$(dirname "$self")" ]]; then
      # write beside the old file, then swap, so there is never half a script
      cp "$new" "$self.new" && chmod 755 "$self.new" && mv -f "$self.new" "$self" \
        || { rm -f "$self.new"; echo "Could not replace $self"; exit 1; }
    else
      echo "Replacing $self needs your password."
      sudo install -m 755 "$new" "$self" || { echo "Could not replace $self"; exit 1; }
    fi
    echo "Updated batterycharging $VERSION to $latest."
    running && echo "A hold is still running the old version; restart it ('on', then 'off' or 'to N') to use the new one."
    exit 0
    ;;
  off)
    running && { echo "Already holding."; [[ -f "$AUTO" ]] && warn; exit 0; }
    sudo -v || exit 1
    sudo nohup "$0" _loop >/dev/null 2>&1 &
    echo "Charging off: holding at $(pct)%. Charge can only go down until 'batterycharging on'."
    warn
    ;;
  to)
    [[ "$2" =~ ^[0-9]+$ ]] && (( $2 >= 1 && $2 <= 100 )) || { echo "usage: batterycharging to <1-100>"; exit 1; }
    sudo -v || exit 1
    sudo nohup "$0" _loop "$2" >/dev/null 2>&1 &
    if (( $(pct) < $2 )); then
      echo "Charging to $2%, then holding. Charge can only go down after that until 'batterycharging on'."
    else
      echo "Already at $(pct)% (>= $2%): holding here. Charge can only go down until 'batterycharging on'."
    fi
    warn
    ;;
  on)
    sudo "$0" _restore && echo "Charging on: previous charge limit restored."
    if [[ -f "$AUTO" ]] && read -r low high < "$AUTO"; then
      echo "Note: auto refill is still set ($low% -> $high%) and will apply to your next hold."
      echo "Run 'batterycharging auto off' to remove it."
    fi
    ;;
  auto)
    if [[ "$2" == off ]]; then
      sudo rm -f "$AUTO" && echo "Auto refill off."
      exit
    fi
    low=${2:-40}; high=${3:-60}
    [[ "$low" =~ ^[0-9]+$ && "$high" =~ ^[0-9]+$ ]] && (( low >= 1 && high <= 100 && low < high )) \
      || { echo "usage: batterycharging auto [<low> <high>] | auto off   (default 40 60)"; exit 1; }
    sudo "$0" _auto "$low" "$high" || exit 1
    echo "Auto refill on: while holding, below $low% it charges back up to $high%, then holds again."
    running || echo "No hold is active right now; this applies once you run 'batterycharging off' or 'to N'."
    ;;
  _auto)      # root
    mkdir -p "$DIR" && echo "$2 $3" > "$AUTO"
    ;;
  _loop)      # root: save original once, optionally charge up to $2, then ratchet down only
    mkdir -p "$DIR"
    [[ -f "$PID" ]] && kill "$(cat "$PID")" 2>/dev/null   # replace any running hold
    echo $$ > "$PID"
    [[ -f "$SAVED" ]] || echo "$(defaults read $D MCLFeatureState 2>/dev/null || echo none) \
$(defaults read $D mclLimitValue 2>/dev/null || echo 100)" > "$SAVED"
    hold=$(pct); [[ -z "$hold" ]] && exit 1
    target=$2
    while :; do
      if [[ -n "$target" ]] && (( hold < target )); then
        setlim "$target"       # firmware charges up to the target and stops there
        while sleep 60; do
          p=$(pct); [[ -z "$p" ]] && continue
          (( p >= target )) && break
          # firmware may settle a point or two short of the limit: treat that as done
          if (( p >= target - 2 )) && pmset -g batt | grep -q "AC Power" \
             && ! pmset -g batt | grep -q "; charging"; then break; fi
        done
        hold=$(pct); [[ -z "$hold" ]] && hold=$target
        (( hold > target )) && hold=$target
      fi
      setlim "$hold"
      target=
      while sleep 60; do
        p=$(pct); [[ -z "$p" ]] && continue
        if (( p < hold )); then hold=$p; setlim "$hold"; fi
        # auto refill (only if 'batterycharging auto' was set): below LOW, charge up to HIGH
        if [[ -f "$AUTO" ]] && read -r low high < "$AUTO" && [[ -n "$high" ]] && (( p < low )); then
          target=$high; break
        fi
      done
    done
    ;;
  _restore)   # root
    [[ -f "$PID" ]] && kill "$(cat "$PID")" 2>/dev/null; rm -f "$PID"
    if [[ ! -f "$SAVED" ]]; then
      echo "No hold was active; charge limit left unchanged."; exit 1
    fi
    read -r st lim < "$SAVED"
    if [[ "$st" == 1 ]]; then
      setlim "$lim"
    elif [[ "$st" == none ]]; then   # charge limit was never set on this Mac: remove our keys
      defaults delete $D MCLFeatureState 2>/dev/null
      defaults delete $D mclLimitValue 2>/dev/null
      notifyutil -p com.apple.smartcharging.defaultschanged
    else
      setlim 100
    fi
    rm -f "$SAVED"
    ;;
  *) echo "usage: batterycharging off|on|to <percent>|auto [<low> <high>]|auto off|--update|--version"; exit 1 ;;
esac
