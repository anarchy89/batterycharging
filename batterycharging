#!/bin/bash
# batterycharging off  -> stop charging: freeze at current %, follow it down, never charge up
# batterycharging to N -> charge up to N%, then hold there exactly like 'off'
# batterycharging on   -> resume charging: stop holding and restore your previous charge limit
# batterycharging range [LOW HIGH] -> opt in (set once): while holding, if the battery falls below
#                         LOW% (default 40), charge back up to HIGH% (default 60), then hold again;
#                         the two numbers can be given in either order
# batterycharging range off -> turn that off again
# batterycharging restart  -> restart a running hold with this script (after an update); the limit stays put
# batterycharging status   -> show the battery, the charge limit, the hold and range, and what to run next
# batterycharging --update  -> replace this script with the latest release, if that is newer
# batterycharging --version -> print the version
VERSION=1.0.8
RELEASE="https://github.com/anarchy89/batterycharging/releases/latest/download/batterycharging"
D=com.apple.smartcharging.topoffprotection
DIR="/Library/Application Support/batterycharging"
PID="$DIR/pid"; SAVED="$DIR/saved"; RANGE="$DIR/range"

pct()     { pmset -g batt | grep -Eo '[0-9]+%' | head -1 | tr -d '%'; }
running() { [[ -f "$PID" ]] && ps -p "$(cat "$PID")" >/dev/null 2>&1; }
setlim()  {   # runs as root
  defaults write $D MCLFeatureState -int 1
  defaults write $D mclLimitValue -int "$1"
  notifyutil -p com.apple.smartcharging.defaultschanged
}
warn()    {   # a hold never charges back up unless 'range' is set
  if [[ -f "$RANGE" ]] && read -r low high < "$RANGE"; then
    echo "Warning: range is on: below $low% it charges back up to $high%, then holds again."
    echo "To hold without recharging, run 'batterycharging range off'."
  else
    echo "Warning: left like this, the battery will eventually drain to 0%. Run 'batterycharging on'"
    echo "when it gets low, or set 'batterycharging range' to recharge automatically."
  fi
}

case "$1" in
  --version) echo "batterycharging $VERSION" ;;
  --update)
    url=${BATTERYCHARGING_UPDATE_URL:-$RELEASE}    # the variable is an aid for testing
    self=$(realpath "$0" 2>/dev/null || echo "$0")
    new=$(mktemp -t batterycharging) || exit 1
    trap 'rm -f "$new"' EXIT
    echo "Checking $url"
    curl -fsSL -o "$new" "$url" || { echo "Could not download the latest release."; exit 1; }
    read -r name latest <<< "$(bash "$new" --version 2>/dev/null)"
    [[ "$name" == batterycharging && "$latest" =~ ^[0-9]+(\.[0-9]+)*$ ]] \
      || { echo "The downloaded file is not a working batterycharging."; exit 1; }
    if [[ "$latest" == "$VERSION" || "$(printf '%s\n' "$VERSION" "$latest" | sort -V | tail -1)" != "$latest" ]]; then
      echo "batterycharging $VERSION is up to date (the latest release is $latest)."; exit 0
    fi
    if [[ -w "$(dirname "$self")" ]]; then
      # write beside the old file, then swap, so there is never half a script
      cp "$new" "$self.new" && chmod 755 "$self.new" && mv -f "$self.new" "$self" \
        || { rm -f "$self.new"; echo "Could not replace $self"; exit 1; }
    else
      echo "Replacing $self needs your password."
      sudo install -m 755 "$new" "$self" || { echo "Could not replace $self"; exit 1; }
    fi
    # hand over to the file just installed, so what happens after an update is decided by the new version
    rm -f "$new"; trap - EXIT
    exec "$self" _updated "$VERSION"
    ;;
  _updated)   # run by --update from the newly installed file; $2 is the version that was replaced
    echo "Updated batterycharging ${2:-?} to $VERSION."
    if running; then
      echo "A hold is still running the old version."
      ans=n
      # ask only when someone is there to answer
      if [[ -t 0 ]]; then
        read -r -p "Restart it now with the new one? This runs: batterycharging restart [Y/n] " ans || ans=n
      fi
      case "$ans" in
        n*|N*) echo "Left as it is. To restart it later, run: batterycharging restart" ;;
        *)     "$0" restart || echo "The restart did not work. Try again with: batterycharging restart" ;;
      esac
    fi
    echo "Run 'batterycharging status' to see what is set."
    ;;
  restart)
    running || { echo "No hold is running. Start one with 'batterycharging off' or 'to N'."; exit 1; }
    sudo -v || exit 1
    # a hold that is still charging up to a target has a limit well above the battery level: keep that target
    lim=$(sudo defaults read $D mclLimitValue 2>/dev/null); p=$(pct); target=
    [[ "$lim" =~ ^[0-9]+$ && -n "$p" ]] && (( lim - p > 2 )) && target=$lim
    old=$(cat "$PID" 2>/dev/null)
    sudo nohup "$0" _loop $target >/dev/null 2>&1 &
    echo "Hold restarted with batterycharging $VERSION. What this did:"
    echo "  - Stopped the old background loop${old:+ (process $old)} and started a new one from this script."
    if [[ -n "$target" ]]; then
      echo "  - Kept the charge limit at $target%: the battery is at $p%, so it carries on charging up to"
      echo "    $target% and then holds there."
    else
      echo "  - Set the charge limit to $p%, the current battery level. It follows the battery down from here."
    fi
    if [[ -f "$SAVED" ]] && read -r st sl < "$SAVED"; then
      [[ "$st" == 1 ]] || sl=100
      echo "  - Did not restore your normal limit ($sl%) in between, so nothing charged. 'batterycharging on'"
      echo "    still restores it."
    fi
    warn
    ;;
  status)
    batt=$(pmset -g batt); p=$(pct)
    src=$(echo "$batt" | sed -n "s/.*'\(.*\)'.*/\1/p" | head -1)
    chg=$(echo "$batt" | sed -n 's/.*[0-9]%; \(.*\)/\1/p' | head -1 \
          | sed -e 's/ present:.*//' -e 's/; [0-9:]* remaining//' -e 's/; (no estimate)//' -e 's/^AC attached; //')
    echo "Reading the charge limit needs your password."
    if sudo -v; then
      state=$(sudo defaults read $D MCLFeatureState 2>/dev/null); lim=$(sudo defaults read $D mclLimitValue 2>/dev/null)
      if [[ "$state" == 1 && -n "$lim" ]]; then limit="$lim%"; else limit="none (charges to 100%)"; lim=100; fi
    else
      limit="unknown (no admin password given)"; lim=
    fi
    was=
    if [[ -f "$SAVED" ]]; then
      read -r st sl < "$SAVED"
      if [[ "$st" == 1 ]]; then was="$sl% charge limit"; else was="no charge limit (100%)"; fi
    fi
    low=; high=; [[ -f "$RANGE" ]] && read -r low high < "$RANGE"
    echo
    echo "batterycharging $VERSION"
    echo "  Battery:       ${p:-?}%, on ${src:-unknown power}${chg:+, $chg}"
    echo "  Charge limit:  $limit"
    if running; then
      if [[ -n "$lim" && -n "$p" ]] && (( lim - p > 2 )); then
        echo "  Hold:          on, charging up to $lim% first, then holding"
      else
        echo "  Hold:          on, the limit follows the battery down, unless range is on (see Range for its limits)"
      fi
    elif [[ -f "$SAVED" ]]; then
      echo "  Hold:          STOPPED, but the limit it set is still in place"
    else
      echo "  Hold:          off, macOS charges normally"
    fi
    if [[ -n "$high" ]]; then
      echo "  Range:         on, below $low% a hold charges back up to $high%"
    else
      echo "  Range:         off"
    fi
    [[ -n "$was" ]] && echo "  'on' restores: $was"
    echo
    echo "What you can do:"
    if running; then
      [[ "$0" -nt "$PID" ]] && \
        echo "  ! This hold was started before the script was last updated. To use the new version," && \
        echo "    run: batterycharging restart"
      echo "  batterycharging on         back to normal charging${was:+ ($was)}"
      echo "  batterycharging to N       charge up to N% now, then hold there"
      if [[ -n "$high" ]]; then
        echo "  batterycharging range off  stop the recharging, so the hold only ever goes down"
      else
        echo "  batterycharging range      recharge to 60% whenever a hold falls below 40%"
        echo "  ! Without range, this hold will eventually drain the battery to 0%."
      fi
    elif [[ -f "$SAVED" ]]; then
      echo "  ! The hold's background loop is not running (it stops at a restart), so the limit no longer"
      echo "    follows the battery down and range is not working. The Mac will not charge past $limit."
      echo "  batterycharging on         back to normal charging${was:+ ($was)}"
      echo "  batterycharging off        start a new hold at the current level"
      echo "  batterycharging to N       start a new hold after charging up to N%"
    else
      echo "  batterycharging off        stop charging and hold at the current level"
      echo "  batterycharging to N       charge up to N%, then hold there"
      if [[ -n "$high" ]]; then
        echo "  batterycharging range off  remove the saved range"
      else
        echo "  batterycharging range      set once: recharge to 60% whenever a hold falls below 40%"
      fi
    fi
    ;;
  off)
    running && { echo "Already holding."; [[ -f "$RANGE" ]] && warn; exit 0; }
    sudo -v || exit 1
    sudo nohup "$0" _loop >/dev/null 2>&1 &
    echo "Charging off: holding at $(pct)%. Charge can only go down until 'batterycharging on'."
    warn
    ;;
  to)
    [[ "$2" =~ ^[0-9]+$ ]] && (( $2 >= 1 && $2 <= 100 )) || { echo "usage: batterycharging to <1-100>"; exit 1; }
    sudo -v || exit 1
    sudo nohup "$0" _loop "$2" >/dev/null 2>&1 &
    if (( $(pct) < $2 )); then
      echo "Charging to $2%, then holding. Charge can only go down after that until 'batterycharging on'."
    else
      echo "Already at $(pct)% (>= $2%): holding here. Charge can only go down until 'batterycharging on'."
    fi
    warn
    ;;
  on)
    sudo "$0" _restore && echo "Charging on: previous charge limit restored."
    if [[ -f "$RANGE" ]] && read -r low high < "$RANGE"; then
      echo "Note: range is still set ($low% -> $high%) and will apply to your next hold."
      echo "Run 'batterycharging range off' to remove it."
    fi
    ;;
  range)
    if [[ "$2" == off ]]; then
      sudo rm -f "$RANGE" && echo "Range off."
      exit
    fi
    usage="usage: batterycharging range [<low> <high>] | range off   (default 40 60, numbers in either order)"
    if [[ -n "$2" && -z "$3" ]]; then
      echo "Give two numbers, or none for the default 40 and 60: for example 'batterycharging range 30 65'."
      echo "$usage"; exit 1
    fi
    low=${2:-40}; high=${3:-60}
    [[ "$low" =~ ^[0-9]+$ && "$high" =~ ^[0-9]+$ ]] || { echo "Both values must be whole numbers from 1 to 100."; echo "$usage"; exit 1; }
    low=$((10#$low)); high=$((10#$high))
    # either order: the smaller number is the low limit, the larger one the high limit
    if (( low > high )); then t=$low; low=$high; high=$t; fi
    if (( low == high )); then
      echo "The two values must be different: one to start charging below, one to charge up to."
      echo "$usage"; exit 1
    fi
    (( low >= 1 && high <= 100 )) || { echo "Both values must be whole numbers from 1 to 100."; echo "$usage"; exit 1; }
    sudo "$0" _range "$low" "$high" || exit 1
    echo "Range on: while holding, below $low% it charges back up to $high%, then holds again."
    p=$(pct)
    if [[ -n "$p" ]] && (( p > high )); then
      echo "Note: the battery is at $p%, above this range. Nothing discharges it, so it is not brought down"
      echo "to $high%: it drifts down by itself. Once it falls below $low% it charges to $high%, and from then on it"
      echo "stays between $low% and $high%."
      echo "To get into the range sooner, unplug the charger until the battery is down to $high% or lower, then"
      echo "plug it back in. Waiting works just as well."
    elif [[ -n "$p" ]] && (( p < low )); then
      if running; then
        echo "Note: the battery is at $p%, below this range. It starts charging to $high% within about a minute."
      else
        echo "Note: the battery is at $p%, below this range. It charges to $high% once a hold is started."
      fi
    fi
    running || echo "No hold is active right now; this applies once you run 'batterycharging off' or 'to N'."
    ;;
  _range)     # root
    mkdir -p "$DIR" && echo "$2 $3" > "$RANGE"
    ;;
  _loop)      # root: save original once, optionally charge up to $2, then ratchet down only
    mkdir -p "$DIR"
    [[ -f "$PID" ]] && kill "$(cat "$PID")" 2>/dev/null   # replace any running hold
    echo $$ > "$PID"
    [[ -f "$SAVED" ]] || echo "$(defaults read $D MCLFeatureState 2>/dev/null || echo none) \
$(defaults read $D mclLimitValue 2>/dev/null || echo 100)" > "$SAVED"
    hold=$(pct); [[ -z "$hold" ]] && exit 1
    target=$2
    while :; do
      if [[ -n "$target" ]] && (( hold < target )); then
        setlim "$target"       # firmware charges up to the target and stops there
        while sleep 60; do
          p=$(pct); [[ -z "$p" ]] && continue
          (( p >= target )) && break
          # firmware may settle a point or two short of the limit: treat that as done
          if (( p >= target - 2 )) && pmset -g batt | grep -q "AC Power" \
             && ! pmset -g batt | grep -q "; charging"; then break; fi
        done
        hold=$(pct); [[ -z "$hold" ]] && hold=$target
        (( hold > target )) && hold=$target
      fi
      setlim "$hold"
      target=
      while sleep 60; do
        p=$(pct); [[ -z "$p" ]] && continue
        if (( p < hold )); then hold=$p; setlim "$hold"; fi
        # range (only if 'batterycharging range' was set): below LOW, charge up to HIGH
        if [[ -f "$RANGE" ]] && read -r low high < "$RANGE" && [[ -n "$high" ]] && (( p < low )); then
          target=$high; break
        fi
      done
    done
    ;;
  _restore)   # root
    [[ -f "$PID" ]] && kill "$(cat "$PID")" 2>/dev/null; rm -f "$PID"
    if [[ ! -f "$SAVED" ]]; then
      echo "No hold was active; charge limit left unchanged."; exit 1
    fi
    read -r st lim < "$SAVED"
    if [[ "$st" == 1 ]]; then
      setlim "$lim"
    elif [[ "$st" == none ]]; then   # charge limit was never set on this Mac: remove our keys
      defaults delete $D MCLFeatureState 2>/dev/null
      defaults delete $D mclLimitValue 2>/dev/null
      notifyutil -p com.apple.smartcharging.defaultschanged
    else
      setlim 100
    fi
    rm -f "$SAVED"
    ;;
  *) echo "usage: batterycharging off|on|to <percent>|range [<low> <high>]|range off|status|restart|--update|--version"; exit 1 ;;
esac
